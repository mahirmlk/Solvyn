# Copy to /etc/solvyn/backup.env; install root:solvyn-backup mode 0640.
# URL-encode special characters in DATABASE_URL.
DATABASE_URL=postgresql://solvyn_backup:URL_ENCODED_PASSWORD@127.0.0.1:5432/solvyn
BACKUP_DIR=/var/backups/solvyn
RETENTION_DAYS=30

# Optional. The host must have AWS CLI and credentials configured for this bucket.
# S3_BUCKET=s3://your-private-backup-bucket/solvyn
