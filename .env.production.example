# Copy to .env.production, replace every placeholder, and restrict file access.
# Use URL-encoded credentials in DATABASE_URL (especially @, :, /, and #).
POSTGRES_USER=solvyn_bootstrap
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_BOOTSTRAP_PASSWORD
POSTGRES_DB=solvyn
POSTGRES_PORT=5432
POSTGRES_MIGRATION_USER=solvyn_migrator
POSTGRES_MIGRATION_PASSWORD=REPLACE_WITH_A_THIRD_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_APP_USER=solvyn_runtime
POSTGRES_APP_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_RUNTIME_PASSWORD
DATABASE_URL=postgresql+asyncpg://solvyn_runtime:URL_ENCODED_RUNTIME_PASSWORD@db:5432/solvyn
MIGRATION_DATABASE_URL=postgresql+asyncpg://solvyn_migrator:URL_ENCODED_MIGRATION_PASSWORD@db:5432/solvyn
REDIS_URL=redis://redis:6379/0
SANDBOX_RUNTIME_TOKEN=REPLACE_WITH_A_LONG_RANDOM_INTERNAL_SERVICE_SECRET

API_KEY_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
INTEGRATION_ENCRYPTION_KEYS=REPLACE_WITH_FERNET_KEY
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_A_LONG_RANDOM_WEBHOOK_SECRET
ALLOW_INSECURE_DEV=false
ALLOW_PUBLIC_REGISTRATION=false
DEFAULT_TENANT_ID=default

OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
LLM_DEFAULT_PROVIDER=openrouter
LLM_DEFAULT_MODEL=openai/gpt-4o
LOG_LEVEL=INFO
JSON_LOGGING=true
ALLOWED_ORIGINS='["https://your-public-hostname"]'

# Published only on loopback; put a TLS reverse proxy in front of these.
API_PORT=8000
FRONTEND_PORT=3000
