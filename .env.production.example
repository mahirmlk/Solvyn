# Compose interpolation secrets. Copy to .env.production and restrict file access.
# Application settings belong in .env.application, which is loaded only by API/worker.
# Use URL-encoded credentials in database URL values (especially @, :, /, and #).
POSTGRES_USER=solvyn_bootstrap
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_BOOTSTRAP_PASSWORD
POSTGRES_DB=solvyn
POSTGRES_PORT=5432
POSTGRES_MIGRATION_USER=solvyn_migrator
POSTGRES_MIGRATION_PASSWORD=REPLACE_WITH_A_THIRD_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_APP_USER=solvyn_runtime
POSTGRES_APP_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_RUNTIME_PASSWORD
POSTGRES_BACKUP_USER=solvyn_backup
POSTGRES_BACKUP_PASSWORD=REPLACE_WITH_A_SEPARATE_LONG_RANDOM_BACKUP_PASSWORD
POSTGRES_RESTORE_USER=solvyn_restore
POSTGRES_RESTORE_PASSWORD=REPLACE_WITH_A_SEPARATE_LONG_RANDOM_RESTORE_PASSWORD
MIGRATION_DATABASE_URL=postgresql+asyncpg://solvyn_migrator:URL_ENCODED_MIGRATION_PASSWORD@db:5432/solvyn
BACKUP_DATABASE_URL=postgresql://solvyn_backup:URL_ENCODED_BACKUP_PASSWORD@db:5432/solvyn
RESTORE_DATABASE_URL=postgresql://solvyn_restore:URL_ENCODED_RESTORE_PASSWORD@db:5432/solvyn
SANDBOX_RUNTIME_TOKEN=REPLACE_WITH_A_LONG_RANDOM_INTERNAL_SERVICE_SECRET

# Published only on loopback; put a TLS reverse proxy in front of these.
API_PORT=8000
FRONTEND_PORT=3000
