# Solvyn Configuration

## Database
POSTGRES_USER=solvyn_bootstrap
POSTGRES_PASSWORD=changeme
POSTGRES_DB=solvyn
POSTGRES_MIGRATION_USER=solvyn_migrator
POSTGRES_MIGRATION_PASSWORD=solvyn_migrator
POSTGRES_APP_USER=solvyn_runtime
POSTGRES_APP_PASSWORD=solvyn_runtime
DATABASE_URL=postgresql+asyncpg://solvyn_runtime:solvyn_runtime@localhost:5432/solvyn
MIGRATION_DATABASE_URL=postgresql+asyncpg://solvyn_migrator:solvyn_migrator@localhost:5432/solvyn

## Redis
REDIS_URL=redis://localhost:6379/0

## LLM API Keys
OPENROUTER_API_KEY=<your-openrouter-api-key>
GROQ_API_KEY=<your-groq-api-key>
DEEPSEEK_API_KEY=<your-deepseek-api-key>

## Default LLM Model Selection
LLM_DEFAULT_PROVIDER=openrouter
LLM_DEFAULT_MODEL=openai/gpt-4o

## Multi-tenant
DEFAULT_TENANT_ID=default

## Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
SANDBOX_WORKSPACE_ROOT=.solvyn/workspaces
SANDBOX_IMAGE=solvyn-sandbox:local

## Auth
API_KEY_SECRET=<generate-a-strong-random-secret>
JWT_SECRET=<generate-a-different-strong-random-secret>
# Registration is disabled by default. Set to true for local/dev.
# In any networked deployment keep this false and register the first user with:
#   curl -X POST .../auth/register -H "X-Bootstrap-Token: $BOOTSTRAP_TOKEN" ...
ALLOW_PUBLIC_REGISTRATION=false
BOOTSTRAP_TOKEN=<optional-one-time-bootstrap-token>
# Optional until a GitHub organization integration is connected. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# For key rotation, provide comma-separated keys with the newest key first.
INTEGRATION_ENCRYPTION_KEYS=<fernet-key>
# Shared GitHub webhook secret; must exactly match the repository webhook setting.
GITHUB_WEBHOOK_SECRET=<random-webhook-secret>
# Optional: set to true only for local development (disables secret checks).
ALLOW_INSECURE_DEV=false

## Auth TTLs
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

## Database pool (Phase 0 audit: connection-storm risk)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
