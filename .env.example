# Solvyn Configuration

## Database
DATABASE_URL=postgresql+asyncpg://solvyn:changeme@localhost:5432/solvyn

## Redis
REDIS_URL=redis://localhost:6379/0

## LLM API Keys
OPENROUTER_API_KEY=<your-openrouter-api-key>
GROQ_API_KEY=<your-groq-api-key>
DEEPSEEK_API_KEY=<your-deepseek-api-key>

## Default LLM Model Selection
LLM_DEFAULT_PROVIDER=openrouter
LLM_DEFAULT_MODEL=openai/gpt-4o

## Multi-tenant
DEFAULT_TENANT_ID=default

## Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

## Auth
API_KEY_SECRET=<generate-a-strong-random-secret>
