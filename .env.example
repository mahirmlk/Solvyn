# Solvyn Configuration

## Database
DATABASE_URL=postgresql+asyncpg://solvyn:solvyn@localhost:5432/solvyn

## Redis
REDIS_URL=redis://localhost:6379/0

## LLM API Keys
OPENROUTER_API_KEY=sk-or-v1-
GROQ_API_KEY=gsk_
DEEPSEEK_API_KEY=sk-

## Default LLM Model Selection
LLM_DEFAULT_PROVIDER=openrouter
LLM_DEFAULT_MODEL=openai/gpt-4o

## Multi-tenant
DEFAULT_TENANT_ID=default

## Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

## Auth
API_KEY_SECRET=change-me-to-a-random-secret
